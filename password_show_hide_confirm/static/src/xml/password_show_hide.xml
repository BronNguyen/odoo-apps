<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="password_show_hide_confirm.PasswordShowHide" t-inherit="web.CharField" t-inherit-mode="primary" owl="1">
        <input position="replace">
            <span t-if="!state.passwordConfirmed" class="password-warning">The password and confirmation password must be the same</span>
            <div class="pw-input-container">
                <input class="o_input" t-att-class="{'o_field_translate': isTranslatable}" t-att-id="props.id" t-att-type="props.isPassword ? 'password' : 'text'" t-att-autocomplete="props.autocomplete or (props.isPassword ? 'new-password' : 'off')" t-att-maxlength="maxLength > 0 and maxLength" t-att-placeholder="props.placeholder" t-ref="input" t-on-change="()=>this.checkPasswordConfirmation()"/>
                <span class="toggle-password" t-on-click="_onTogglePassword">
                    <i t-if="state.isPassword" class="fa fa-eye"></i>
                    <i t-if="!state.isPassword" class="fa fa-eye-slash"></i>
                </span>
            </div>
        </input>
    </t>
</templates>