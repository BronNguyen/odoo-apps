<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ChatAIRenderer">
        <div class="chat_ai_container">
            <div class="history_section" t-ref="container-ref">
                <t t-set="i" t-value="0"/>
                <t t-foreach="state.chat_history" t-as="line" t-key="++i">
                    <t t-if="line.is_user">
                        <div class="chat-ai-user">
                            <t t-out="markupMessage(line.message)"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="chat-ai-bot">
                            <t t-out="markupMessage(line.message)"/>
                        </div>
                    </t>
                </t>
            </div>
            <div class="answer_response_section">
                <div class="chat-bot-response">
                    <t t-out="markupMessage(state.answer_response)"/>
                </div>
            </div>
            <div class="chat_input_section">
                <button class="file_upload_button" t-on-click="onFileUploadClick">
                    <i class="fa fa-paperclip"></i>                    <!-- Font Awesome Icon -->
                    <input type="file" class="file_input" t-ref="file_input_ref" style="display: none;" t-on-change="onFileChange"/>
                </button>
                <div class="chat_input_wrapper" t-att-style="state.imageThumbnail and 'padding-left: 50px;'">
                    <div contenteditable="true" class="chat_input" t-ref="chat_input_ref" t-on-paste="onPasteImage"></div>
                    <img class="chat_input_thumbnail" t-att-src="state.imageThumbnail" t-att-style="`display: ${state.imageThumbnail ? 'block' : 'none'}`"/>
                    <div t-if="state.imageThumbnail" class="close-thumbnail" t-on-click="onRemoveImage">X</div>
                </div>
                <button class="chat_send_button" t-att-disabled="state.is_blocked" t-on-click="onSendQuestion">Send</button>
            </div>

        </div>
    </t>

</templates>
