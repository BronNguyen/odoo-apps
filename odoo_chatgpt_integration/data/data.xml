<odoo>
    <data noupdate="1">
        <record id="api_key_config_parameter" model="ir.config_parameter">
            <field name="key">openai.api_key</field>
            <field name="value">api_key</field>
        </record>

        <record id="api_web_rtc_url" model="ir.config_parameter">
            <field name="key">web_rtc_url</field>
            <field name="value">https://api.openai.com/v1/realtime</field>
        </record>

        <record id="api_web_rtc_sessions_url" model="ir.config_parameter">
            <field name="key">web_rtc_sessions_url</field>
            <field name="value">https://api.openai.com/v1/realtime/sessions</field>
        </record>

        <record id="api_web_websocket_url" model="ir.config_parameter">
            <field name="key">web_websocket_url</field>
            <field name="value">wss://api.openai.com/v1/realtime</field>
        </record>

        <record id="chatgpt.organization_id" model="ir.config_parameter">
            <field name="key">chatgpt.organization_id</field>
            <field name="value">organization id</field>
        </record>

        <record id="chatgpt.project_id" model="ir.config_parameter">
            <field name="key">chatgpt.project_id</field>
            <field name="value">project id</field>
        </record>

        <record id="openai_beta_protocol" model="ir.config_parameter">
            <field name="key">openai_beta_protocol</field>
            <field name="value">openai-beta.realtime-v1</field>
        </record>

        <record id="openai_completion_url" model="ir.config_parameter">
            <field name="key">openai_completion_url</field>
            <field name="value">https://api.openai.com/v1/chat/completions</field>
        </record>

        <record id="openai_model" model="ir.config_parameter">
            <field name="key">openai_model</field>
            <field name="value">gpt-4o</field>
        </record>

        <record id="openai_connection" model="ir.config_parameter">
            <field name="key">openai_connection</field>
            <field name="value">http</field>
        </record>
    </data>
</odoo>